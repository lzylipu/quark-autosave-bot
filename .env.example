# Quark AutoSave Bot
# Copy to .env and fill in your values

# Required
TELEGRAM_BOT_TOKEN=你的Bot_Token
# QASx 的接口令牌：浏览器先登录 QASx WebUI，再打开
#   http://<你的QASx地址>/data
# 返回 JSON 里的 "api_token" 字段就是它（不是 WebUI 里的「API 密钥」，QASx 没这个设置）
QAS_TOKEN=你的api_token

# Optional
# 你的 TG 用户 ID。留空 = 私聊谁都能用；填了就只认这些人（群里一律不响应）
SUPERUSER=
QAS_ENDPOINT=http://quark-auto-save:5005
QAS_PATH_BASE=夸克自动转存
SIMPLE_SAVE_ROOT=自动
# 单次转存整体超时（秒）
QAS_RUN_TIMEOUT=1800
# 同一链接多少秒内重复发送时直接返回上次结果
DEDUPE_SECONDS=600
# 分享需要提取码时是否在聊天里追问
ASK_PASSCODE=true
# ===== 追剧订阅 =====
# 每天几点执行订阅（HH:MM）
SUB_CHECK_TIME=17:00
# 每集大小区间（GB），分享里全部视频都在区间内才会转存
SUB_MIN_SIZE_GB=1.5
SUB_MAX_SIZE_GB=8.0
# 每个订阅最多检查多少个搜索结果（0 = 搜到多少看多少，默认；盘搜热门资源常排在几十条之后）
SUB_MAX_CANDIDATES=0
# 已经凑够这么多个合格分享就不再继续扫（省时间）
SUB_MAX_OK_CANDIDATES=1
# 全部都不在区间内时退一档：每集中位数 >= 这个值就当正片下（挡枪版）
SUB_FALLBACK_MIN_SIZE_GB=0.5

QAS_PORT=5005
QAS_WEBUI_USER=admin
QAS_WEBUI_PASS=
