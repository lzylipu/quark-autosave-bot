# Quark AutoSave Bot
# Copy to .env and fill in your values

# Required
TELEGRAM_BOT_TOKEN=你的Bot_Token
# QAS WebUI「设置 → API 密钥」里的值
QAS_TOKEN=你的QAS密钥

# Optional
# 你的 TG 用户 ID。留空 = 私聊谁都能用；填了就只认这些人（群里一律不响应）
SUPERUSER=
QAS_ENDPOINT=http://quark-auto-save:5005
QAS_PATH_BASE=夸克自动转存
SIMPLE_SAVE_ROOT=自动
# 单次转存整体超时（秒）
QAS_RUN_TIMEOUT=1800
# 同一链接多少秒内重复发送时直接返回上次结果
DEDUPE_SECONDS=600
# 分享需要提取码时是否在聊天里追问
ASK_PASSCODE=true
QAS_PORT=5005
QAS_WEBUI_USER=admin
QAS_WEBUI_PASS=
